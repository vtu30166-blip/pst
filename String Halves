public class Main {
    public static void main(String[] args) {

        String s = "book";

        String vowels = "aeiouAEIOU";

        int mid = s.length() / 2;

        int count1 = 0;
        int count2 = 0;

        // First half
        for (int i = 0; i < mid; i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count1++;
            }
        }

        // Second half
        for (int i = mid; i < s.length(); i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count2++;
            }
        }

        System.out.println(count1 == count2);
    }
}
