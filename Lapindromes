import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {

            String s = sc.next();

            int n = s.length();
            int mid = n / 2;

            int[] countLeft = new int[26];
            int[] countRight = new int[26];

            // Count left half
            for (int i = 0; i < mid; i++) {
                countLeft[s.charAt(i) - 'a']++;
            }

            // Count right half
            for (int i = (n + 1) / 2; i < n; i++) {
                countRight[s.charAt(i) - 'a']++;
            }

            // Compare frequencies
            boolean isLapindrome = true;

            for (int i = 0; i < 26; i++) {
                if (countLeft[i] != countRight[i]) {
                    isLapindrome = false;
                    break;
                }
            }

            if (isLapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }

        sc.close();
    }
}
